# Settings for signing release builds (for Google Play) in Android Studio.
# Copy this file to keystore.properties and write the location and the password of the upload key.
# Never publish keystore.properties or the key file (both are excluded in .gitignore).
# Paths are relative to the folder of this file (the top of the project).
storeFile=signing/qcalc-upload.jks
storePassword=password-of-the-upload-key
keyAlias=upload
keyPassword=password-of-the-upload-key
