<?xml version="1.0" encoding="utf-8"?>
<!-- The package name (io.github.hiroshitsu.qcalc) is set by the namespace in app/build.gradle.
     build-apk.sh and build-aab.sh add the package attribute when they build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 1.11.0: the languages of the app are listed for the system settings (android:localeConfig,
         Android 13 and later), and a change of the languages (locale) no longer makes the activity
         again: MainActivity.onConfigurationChanged tells the page, which loads itself again only when
         the app's language changed, keeping the history and what is being typed. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="false"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1.12.0: the widget on the home screen (Widget.java), the tile of the quick settings
             (QuickTile.java, Android 7 and later). Both open MainActivity at a place (Quick.java);
             the shortcuts of the icon are set from the code (dynamic shortcuts, Android 7.1 and later). -->
        <receiver
            android:name=".Widget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <service
            android:name=".QuickTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
