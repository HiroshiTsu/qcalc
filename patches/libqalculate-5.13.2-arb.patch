+// a real number as a ball; point is set to false for an interval
+static bool arb_set_number(arb_t x, const Number &n, slong prec, bool &point) {
+	if(n.hasImaginaryPart()) return false;
+	if(n.isRational()) {
+		fmpq_t q;
+		fmpq_init(q);
+		fmpq_set_mpq(q, n.internalRational());
+		arb_set_fmpq(x, q, prec);
+		fmpq_clear(q);
+		return true;
+	}
+	if(!n.isFloatingPoint()) return false;
+	if(!mpfr_number_p(n.internalLowerFloat()) || !mpfr_number_p(n.internalUpperFloat())) return false;
+	arb_set_interval_mpfr(x, n.internalLowerFloat(), n.internalUpperFloat(), prec);
+	if(!mpfr_equal_p(n.internalLowerFloat(), n.internalUpperFloat())) point = false;
+	return true;
