+			mpfr_init2(fu_value, bits);
+			mpq_set_ui(r_value, 0, 1);
+			n_type = NUMBER_TYPE_FLOAT;
+		} else {
+			mpfr_set_prec(fl_value, bits);
+			mpfr_set_prec(fu_value, bits);
+		}
