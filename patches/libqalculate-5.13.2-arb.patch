+bool Number::arbFunction(int fn, const Number *o) {
+	if(PRECISION < ARB_MIN_PRECISION || !CALCULATOR || CALCULATOR->aborted()) return false;
+	if(hasImaginaryPart() || (o && o->hasImaginaryPart())) return false;
