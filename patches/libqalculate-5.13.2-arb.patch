+					fmpq_t q;
+					fmpq_init(q);
+					fmpq_set_mpq(q, r_value);
+					arb_gamma_fmpq(y, q, prec);
+					fmpq_clear(q);
+				} else {
+					arb_gamma(y, x, prec);
+				}
+				break;
+			}
+			case ARB_DIGAMMA: {arb_digamma(y, x, prec); break;}
+			case ARB_ERF: {arb_hypgeom_erf(y, x, prec); break;}
+			case ARB_ERFC: {arb_hypgeom_erfc(y, x, prec); break;}
+			case ARB_ERFINV: {arb_hypgeom_erfinv(y, x, prec); break;}
+			case ARB_AIRY: {arb_hypgeom_airy(y, NULL, NULL, NULL, x, prec); break;}
+			case ARB_BESSELJ: {arb_hypgeom_bessel_j(y, s, x, prec); break;}
+			case ARB_BESSELY: {arb_hypgeom_bessel_y(y, s, x, prec); break;}
+			case ARB_POLYLOG: {arb_polylog(y, s, x, prec); break;}
+			case ARB_EI: {arb_hypgeom_ei(y, x, prec); break;}
+			case ARB_LI: {arb_hypgeom_li(y, x, 0, prec); break;}
+			case ARB_SI: {arb_hypgeom_si(y, x, prec); break;}
+			case ARB_CI: {arb_hypgeom_ci(y, x, prec); break;}
+			case ARB_SHI: {arb_hypgeom_shi(y, x, prec); break;}
+			case ARB_CHI: {arb_hypgeom_chi(y, x, prec); break;}
